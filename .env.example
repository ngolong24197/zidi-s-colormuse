# ColorMuse configuration — copy to .env (local) or put the same keys in
# .streamlit/secrets.toml / Streamlit Cloud "Secrets". Never commit real values.

# Backend: "supabase" (production) or "local" (development only: SQLite + local folder)
COLORMUSE_BACKEND=supabase

# Supabase project (Project Settings -> API). Use the *anon* (publishable) key only.
# NEVER put the service-role key here: the app must not have it.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_BUCKET=wardrobe

# The one account allowed to sign in (created in Supabase Auth -> Users).
OWNER_EMAIL=owner@example.com

# Local development backend only (COLORMUSE_BACKEND=local)
COLORMUSE_LOCAL_PASSWORD=change-me
COLORMUSE_LOCAL_DIR=.colormuse_local
