# Copy to .streamlit/secrets.toml (local) or paste into Streamlit Cloud → App → Settings → Secrets.
# Never commit the real file.

COLORMUSE_BACKEND = "supabase"
SUPABASE_URL = "https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY = "your-anon-public-key"   # anon / publishable key ONLY — never the service-role key
SUPABASE_BUCKET = "wardrobe"
OWNER_EMAIL = "owner@example.com"
